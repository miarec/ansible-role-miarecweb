---
# ansible-lint reads this file too, so the yaml[...] entries in .ansible-lint
# and the rules here should agree.
extends: default

ignore:
  - .venv/

rules:
  # Allow `{ key: value }` with spaces inside the braces.
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  colons: disable
  commas: disable
  comments: disable
  empty-lines: disable
  line-length: disable
  trailing-spaces: disable
  truthy: disable
